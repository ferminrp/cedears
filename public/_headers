# Cloudflare Workers static assets headers. Assets are served before the
# Worker (no run_worker_first), so middleware.ts and the www→apex gateway never
# see these paths. Having this file in public/ stops vinext from generating its
# default _headers, so its immutable rule is repeated here.

# Cache content-hashed assets immutably (same rule vinext generates)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: always revalidate so a new version is picked up on the next load.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Offline fallback precached by the SW; not a page for search engines.
# Static assets serve public/offline.html at /offline (/offline.html → 307).
/offline
  Cache-Control: no-cache
  X-Robots-Tag: noindex
/offline.html
  Cache-Control: no-cache
  X-Robots-Tag: noindex
