{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "NEXT_PUBLIC_SITE_URL=https://cedears.com vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --import ./tests/register-ts.mjs --test tests/*.test.ts",
    "verify": "node scripts/verify-cedears.mjs",
    "cf:build": "NEXT_PUBLIC_SITE_URL=https://cedears.com vinext build",
    "cf:deploy": "node --experimental-strip-types --import ./tests/register-ts.mjs scripts/indexnow/cf-deploy.ts",
    "indexnow:submit-all": "node --experimental-strip-types --import ./tests/register-ts.mjs scripts/indexnow/submit-all.ts",
    "indexnow:ping-changed": "node --experimental-strip-types --import ./tests/register-ts.mjs scripts/indexnow/ping-changed.ts",
    "cf:preview": "wrangler versions upload --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vinext/cloudflare": "1.0.0-beta.3",
    "class-variance-authority": "^0.7.1",
