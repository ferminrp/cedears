    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.3",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "playwright": "1.51.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "^8.3.5",
    "webpack": "^5.112.2",
    "wrangler": "^4.156.1"
  },
